{
  "name": "lumo",
  "version": "0.3.0",
  "description": "Lumo — navegador inteligente (MVP)",
  "main": "./out/main/index.js",
  "author": "lumo",
  "private": true,
  "scripts": {
    "dev": "node scripts/electron-vite.js dev",
    "build": "electron-vite build",
    "start": "node scripts/electron-vite.js preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release": "node scripts/release.js",
    "sign:vmp": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource-variable/nunito": "5.3.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "lucide-react": "1.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "git+https://github.com/castlabs/electron-releases.git#v33.4.11+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "github:castlabs/electron-releases#d1cf58c11ec0a8a04f307ed362d7efde2816778d": true,
    "electron-winstaller@5.4.0": true
  }
}
