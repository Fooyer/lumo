# Copy this file to ".env" (which git ignores) and fill it in.
# Token used by `npm run release` to publish GitHub Releases of Fooyer/lumo.
# Create one at https://github.com/settings/tokens?type=beta (fine-grained, repository Fooyer/lumo,
# permission "Contents: Read and write") or a classic token with the "repo" scope.
GH_TOKEN=
